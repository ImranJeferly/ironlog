rules_version = '2';
// IronLog Firestore rules.
//
// Private:  users/{uid}/**  (training data, settings, metrics, FCM tokens)
//           — owner only.
// Public:   users/{uid}     (profile doc) — any signed-in user reads,
//           owner writes.
// Social:   handles, friendRequests, chats/messages — signed-in users, each
//           scoped to the people involved. Deliberately simple: no nested
//           get()/exists() lookups inside write rules, so batched writes and
//           list queries can't trip over rule evaluation.
//
// Push notifications are sent by Cloud Functions (functions/index.js) with
// the Admin SDK, which bypasses these rules; the app only ever writes the
// documents. Photos and voice notes live in Storage (storage.rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function isUser(uid) {
      return signedIn() && me() == uid;
    }

    /// The keys a write actually changes.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /// True when `them` has blocked me. The one place nested lookups are
    /// worth it: a block has to hold even though the blocked person's own
    /// client would happily write. One extra read per request/message send.
    function blockedBy(them) {
      return exists(
        /databases/$(database)/documents/users/$(them)/blocked/$(me())
      );
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      // Profile: name, handle, photoUrl, stats, now-playing, active session.
      allow read: if signedIn();
      allow write: if isUser(uid);

      // Friend rows. Either side of the pair may write the row (the app
      // writes both rows when a request is accepted, and both when removed) —
      // except the mute flags, which are mine alone to set on my own row.
      match /friends/{fid} {
        allow read: if isUser(uid) || isUser(fid);
        allow create, delete: if isUser(uid) || isUser(fid);
        allow update: if isUser(uid)
            || (isUser(fid) && !changed().hasAny(['muted', 'mutedBroadcasts']));
      }

      // Who I've blocked. Private to me; the rules above read it with
      // exists(), which is not subject to this.
      match /blocked/{other} {
        allow read, write: if isUser(uid);
      }

      // Everything else under a user is private: training data, metrics,
      // and the FCM tokens the push functions fan out to.
      match /{document=**} {
        allow read, write: if isUser(uid);
      }
    }

    // -------------------------------------------------------------- handles
    // @handle -> { uid }. Claim if free or already yours; only you release it.
    match /handles/{handle} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update: if signedIn()
          && resource.data.uid == me()
          && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // ------------------------------------------------------- friendRequests
    // Doc id is "{from}_{to}". Reads are open to signed-in users: the app
    // queries its own requests, and before sending one it *gets* the reverse
    // doc, which usually doesn't exist — a rule that touches resource.data
    // fails on a missing doc and surfaces as permission-denied. Writes are
    // limited to the two people involved, and the pair can't be rewritten.
    match /friendRequests/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
          && request.resource.data.from == me()
          && request.resource.data.to != me()
          && request.resource.data.status == 'pending'
          && id == request.resource.data.from + '_' + request.resource.data.to
          && !blockedBy(request.resource.data.to);
      allow update: if signedIn()
          && (resource.data.from == me() || resource.data.to == me())
          && !changed().hasAny(['from', 'to']);
      allow delete: if signedIn()
          && (resource.data.from == me() || resource.data.to == me());
    }

    // ---------------------------------------------------------------- chats
    // 1:1 chats: only the two members can see or touch them. The chat id is
    // the two uids joined with '_', which is how the app (and the Cloud
    // Function) derive membership without a read.
    match /chats/{chatId} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
          && me() in request.resource.data.members
          && request.resource.data.members.size() == 2;
      // Members are fixed for the life of the chat (re-accepting a friend
      // re-merges the same pair, which the diff sees as unchanged).
      allow update: if signedIn()
          && me() in resource.data.members
          && !changed().hasAny(['members']);
      allow delete: if signedIn() && me() in resource.data.members;

      function isMember() {
        return signedIn() && me() in chatId.split('_');
      }

      /// The other half of a 1:1 chat id.
      function otherMember() {
        return chatId.split('_')[0] == me()
            ? chatId.split('_')[1]
            : chatId.split('_')[0];
      }

      match /messages/{messageId} {
        allow read: if isMember();
        // You can only post as yourself, only into a chat you're in, and not
        // to somebody who has blocked you.
        allow create: if isMember()
            && request.resource.data.from == me()
            && !blockedBy(otherMember());
        // A sent message is immutable except for two things: the receipts,
        // which only the *recipient* stamps, and my own reaction key.
        allow update: if isMember() && (
          (resource.data.from != me()
              && changed().hasOnly(['deliveredAt', 'seenAt']))
          || (changed().hasOnly(['reactions'])
              && request.resource.data.get('reactions', {})
                  .diff(resource.data.get('reactions', {}))
                  .affectedKeys().hasOnly([me()]))
        );
        // Only the author can delete their own message.
        allow delete: if isMember() && resource.data.from == me();
      }
    }

    // -------------------------------------------------------------- reports
    // Write-only: the app files a report, nobody reads it back through a
    // client. Reviewed in the Firebase console.
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporter == me();
      allow read, update, delete: if false;
    }
  }
}

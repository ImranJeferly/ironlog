rules_version = '2';
// IronLog: every user's training data lives under users/{uid}/... and is only
// readable/writable by that signed-in user. The social layer adds a public
// profile document, friend rows, friend requests and 1:1 chats. There is no
// Firebase Storage in this app — profile photos and voice notes are inline
// blobs on documents — so no Storage rules are needed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function requestAccepted(a, b) {
      return exists(/databases/$(database)/documents/friendRequests/$(a + '_' + b))
          && get(/databases/$(database)/documents/friendRequests/$(a + '_' + b)).data.status == 'accepted';
    }

    // Public profile: anyone signed in can read it (friends need the photo,
    // stats and now-playing); only the owner writes it.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isUser(uid);

      // Friend rows. The owner manages their own list; a friend may add or
      // remove *themselves* on your list, and adding needs an accepted
      // request between the two of you.
      match /friends/{fid} {
        allow read: if isUser(uid) || isUser(fid);
        allow create: if isUser(uid)
            || (isUser(fid) && (requestAccepted(fid, uid) || requestAccepted(uid, fid)));
        allow delete: if isUser(uid) || isUser(fid);
      }

      // Everything else under a user is private training data.
      match /{document=**} {
        allow read, write: if isUser(uid);
      }
    }

    // @handle → uid. Readable by everyone signed in; a handle can only be
    // claimed if it is free (or already yours) and only released by its owner.
    match /handles/{handle} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Friend requests: id is "{from}_{to}". The sender creates or cancels it;
    // the recipient accepts or declines.
    match /friendRequests/{id} {
      allow read: if signedIn()
          && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to != request.auth.uid
          && id == request.resource.data.from + '_' + request.resource.data.to
          && request.resource.data.status == 'pending';
      allow update: if signedIn() && resource.data.to == request.auth.uid
          && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if signedIn()
          && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // 1:1 chats: only the two members can see or touch them.
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        allow read: if signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if signedIn()
            && request.resource.data.from == request.auth.uid
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        // Delivery / seen receipts are written by the recipient.
        allow update: if signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }
  }
}

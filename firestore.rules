rules_version = '2';
// IronLog Firestore rules.
//
// Private:  users/{uid}/**  (training data, settings, metrics) — owner only.
// Public:   users/{uid}     (profile doc) — any signed-in user reads,
//           owner writes.
// Social:   handles, friendRequests, chats/messages — signed-in users, each
//           scoped to the people involved. Deliberately simple: no nested
//           get()/exists() lookups inside write rules, so batched writes and
//           list queries can't trip over rule evaluation.
//
// No Firebase Storage is used (photos and voice notes are inline blobs).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function isUser(uid) {
      return signedIn() && me() == uid;
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      // Profile: name, handle, photo, stats, now-playing, active session.
      allow read: if signedIn();
      allow write: if isUser(uid);

      // Friend rows. Either side of the pair may write the row (the app
      // writes both rows when a request is accepted, and both when removed).
      match /friends/{fid} {
        allow read, write: if isUser(uid) || isUser(fid);
      }

      // Everything else under a user is private training data.
      match /{document=**} {
        allow read, write: if isUser(uid);
      }
    }

    // -------------------------------------------------------------- handles
    // @handle -> { uid }. Claim if free or already yours; only you release it.
    match /handles/{handle} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update: if signedIn()
          && resource.data.uid == me()
          && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // ------------------------------------------------------- friendRequests
    // Doc id is "{from}_{to}". Reads are open to signed-in users: the app
    // queries its own requests, and before sending one it *gets* the reverse
    // doc, which usually doesn't exist — a rule that touches resource.data
    // fails on a missing doc and surfaces as permission-denied. Writes are
    // limited to the two people involved.
    match /friendRequests/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
          && request.resource.data.from == me()
          && request.resource.data.to != me();
      allow update, delete: if signedIn()
          && (resource.data.from == me() || resource.data.to == me());
    }

    // ---------------------------------------------------------------- chats
    // 1:1 chats: only the two members can see or touch them.
    match /chats/{chatId} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && me() in request.resource.data.members;
      allow update, delete: if signedIn() && me() in resource.data.members;

      function isMember() {
        return signedIn()
            && me() in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }

      match /messages/{messageId} {
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.from == me();
        // Delivered / seen receipts are written by the recipient.
        allow update, delete: if isMember();
      }
    }
  }
}

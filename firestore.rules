rules_version = '2';
// IronLog is single-user: every document lives under users/{uid} and is only
// readable/writable by that signed-in (anonymous) user. There is no Firebase
// Storage in this app — progress photos never leave the device — so no Storage
// rules are needed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
